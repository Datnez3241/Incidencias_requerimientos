{
  "manifest_version": 3,
  "name": "Ticket Extractor (IM/RF)",
  "version": "1.7",
  "description": "Extrae datos de tickets IM/RF a un archivo Excel/CSV y sincroniza con SharePoint",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sharepoint_filler.js"],
      "matches": ["https://claromovilco-my.sharepoint.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
